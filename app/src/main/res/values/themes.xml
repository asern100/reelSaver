<resources>
    <style name="Theme.ReelSaver" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/tint</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorPrimaryContainer">@color/tint_soft</item>
        <item name="colorOnPrimaryContainer">@color/tint</item>
        <item name="colorSecondaryContainer">@color/tint_soft</item>
        <item name="colorOnSecondaryContainer">@color/tint</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="colorSurface">@color/card</item>
        <item name="colorOnSurface">@color/label</item>
        <item name="colorSurfaceContainerHigh">@color/card</item>
        <item name="colorSurfaceContainerHighest">@color/card</item>
        <item name="android:textColorPrimary">@color/label</item>
        <item name="android:textColorSecondary">@color/label2</item>
        <item name="android:textColorHint">@color/label2</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">@bool/light_bars</item>
        <item name="materialButtonStyle">@style/Widget.ReelSaver.Button</item>
    </style>

    <style name="Theme.ReelSaver.Player" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">#30D158</item>
        <item name="android:windowBackground">#000000</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
    </style>

    <style name="Widget.ReelSaver.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">17sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">8dp</item>
    </style>

    <style name="Widget.ReelSaver.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0</item>
        <item name="backgroundTint">@color/tint_soft</item>
        <item name="android:textColor">@color/tint</item>
        <item name="iconTint">@color/tint</item>
        <item name="iconGravity">textStart</item>
    </style>

    <style name="ReelSaver.IconButton">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:padding">10dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="tint">@color/tint</item>
    </style>

    <style name="ReelSaver.LargeTitle">
        <item name="android:textSize">34sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/label</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>
</resources>
